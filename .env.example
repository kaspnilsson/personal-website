# Server-side proxy to the provider-neutral email control plane in Renders.
SITE_ORIGIN=https://www.kasptrax.com
EMAIL_SIGNUP_ENDPOINT=https://www.renders.nyc/api/email/subscribe
# Use `vercel` for the current deployment or `replit` for Replit Autoscale.
EMAIL_TRUSTED_PROXY=vercel
# Must match EMAIL_INGEST_SECRET in the Renders deployment. Generate at least
# 32 random bytes and never expose it as a NEXT_PUBLIC_ variable.
EMAIL_INGEST_SECRET=

# Private /fieldnotes catalog. Generate 32 random bytes, base64url-encoded.
# Keep this stable: it protects the encrypted catalog and signs private access.
FIELDNOTES_SECRET=
# Durable server-side saves: connect a private Vercel/Upstash Redis database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Local development only; never used when NODE_ENV=production.
FIELDNOTES_LOCAL_STORE=.fieldnotes-dev
